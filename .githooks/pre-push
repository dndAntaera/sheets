#!/bin/sh
#
# Guard against pushing a change that would damage the live sheets.
#
# GitHub Pages deploys whatever reaches main, and players' characters open in
# whatever it deploys, so a bad commit is a broken app within a couple of
# minutes. This runs before anything leaves the machine.
#
# Override for a deliberate large change:
#     ALLOW_DESTRUCTIVE=1 git push
#
# Minimum share of files under web/ that must survive a push (percent).
SURVIVE_PCT=70

REPO_ROOT=$(git rev-parse --show-toplevel)
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

fail() {
    echo ""
    echo "  PUSH BLOCKED: $1"
    echo ""
    echo "  If this is intentional, re-run as:"
    echo "      ALLOW_DESTRUCTIVE=1 git push"
    echo ""
    exit 1
}

count_web() {
    git ls-tree -r --name-only "$1" -- web 2>/dev/null | grep -c . || echo 0
}

while read -r _local_ref local_sha remote_ref remote_sha; do
    # Nothing being pushed for this ref: a branch deletion.
    [ "$local_sha" = "$ZERO" ] && {
        [ -n "$ALLOW_DESTRUCTIVE" ] || fail "this would DELETE the remote branch $remote_ref."
        continue
    }

    case "$remote_ref" in
        */main) ;;
        *) continue ;;   # only guard main
    esac

    # Compare against the remote tip when we actually have it locally.
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        before=$(count_web "$remote_sha")
        after=$(count_web "$local_sha")

        if [ "$before" -gt 0 ]; then
            threshold=$(( before * SURVIVE_PCT / 100 ))
            if [ "$after" -lt "$threshold" ]; then
                [ -n "$ALLOW_DESTRUCTIVE" ] || fail \
"web/ file count drops $before -> $after (below ${SURVIVE_PCT}% of current)."
            fi
        fi
    fi

    # A push that fails the housekeeping sweep is a push that can break the app:
    # an import of a name that is no longer exported stops every page loading.
    PY=$(command -v python3 || command -v python)
    if [ -n "$PY" ]; then
        echo "pre-push: running the housekeeping sweep..."
        if ! "$PY" "$REPO_ROOT/scripts/sweep.py" >"$REPO_ROOT/.git/sweep.log" 2>&1; then
            echo ""
            echo "  PUSH BLOCKED: the housekeeping sweep found problems."
            grep "FAIL" -A 4 "$REPO_ROOT/.git/sweep.log"
            echo ""
            echo "  Run it yourself to see everything:"
            echo "      python scripts/sweep.py"
            echo ""
            exit 1
        fi
        echo "pre-push: sweep OK."
    fi
done

exit 0
