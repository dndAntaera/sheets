    "Acrobatic": {"effects": [{"target": "skill.Jump", "value": 2}, {"target": "skill.Tumble", "value": 2}]},
    "Agile": {"effects": [{"target": "skill.Balance", "value": 2}, {"target": "skill.Escape Artist", "value": 2}]},
    "Alertness": {"effects": [{"target": "skill.Listen", "value": 2}, {"target": "skill.Spot", "value": 2}]},
