  "variantNotes": {
    "gestalt": "Unearthed Arcana's gestalt variant: every level takes two classes and you keep the better of each. Off unless your table uses it.",
    "actionPoints": "Unearthed Arcana's action points: a small pool of points that add a d6 to a roll.",
    "traitsFlaws": "Unearthed Arcana's traits and flaws: each flaw buys an extra feat."
  },
  "actionPoints": {
    "source": "Unearthed Arcana",
    "mode": "refresh",
    "firstLevel": 5,
    "diceByLevel": [
      {"from": 1, "to": 7, "dice": 1},
      {"from": 8, "to": 14, "dice": 2},
      {"from": 15, "to": 20, "dice": 3}
    ],
    "note": "5 + half your level, renewed at each new level. One point adds the best of the listed d6 to a d20 roll."
  },
  "traitsFlaws": {
    "source": "Unearthed Arcana",
    "traits": 2,
    "flaws": 2,
